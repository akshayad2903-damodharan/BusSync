# ==========================================
# BusSync Environment Configuration (.env.example)
# Copy this file to .env and configure values.
# ==========================================

# Run local zero-dependency simulation mode (true/false)
# Set to 'true' to run full frontend and simulated bus movement without Supabase/Firebase accounts.
VITE_USE_MOCKS=false

# Development mode (true/false)
# Shows top DEV MODE banner and one-tap quick login buttons for Driver, Student, Employee, Admin.
# MUST BE SET TO 'false' FOR PRODUCTION BUILDS!
VITE_DEV_MODE=false

# Supabase Project URL
# Get this from: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Public) Key
# Get this from: Supabase Dashboard -> Project Settings -> API -> Project API keys -> 'anon' public key
VITE_SUPABASE_ANON_KEY=your-anon-public-key-placeholder

# Firebase Web Push Configuration
# Get these from: Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key-placeholder
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-placeholder
VITE_FIREBASE_APP_ID=your-app-id-placeholder
VITE_FIREBASE_VAPID_KEY=your-vapid-key-placeholder
